# Django Core Settings
# Leave blank for local development with DEBUG=True (uses a local dev fallback).
# Before setting DEBUG=False, generate and provide a strong random key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# Security & Cross-Origin Settings (comma-separated lists)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_ALL_ORIGINS=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email (SMTP) Settings — required for password-reset emails
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Smart Water Distribution System <no-reply@example.com>
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-app-password

# Database Settings
# Default is SQLite (DB_ENGINE=sqlite3). Set DB_ENGINE=mysql for optional MySQL support.
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

